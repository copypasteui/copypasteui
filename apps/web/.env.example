# Copy to .env.local (dev) or set in your static host's build settings.
# Everything is optional: with nothing set the site works.

# Public URL of the site (used in prompts, sitemap and the MCP registry URLs)
COPYPASTEUI_SITE_URL=https://copypasteui.dev

# GitHub repository "owner/name" for the Contribute / Star links
NEXT_PUBLIC_GITHUB_REPO=copypasteui/copypasteui

# Cloudflare Web Analytics site token (Cloudflare dashboard → Analytics & Logs → Web Analytics → your site).
# Leave empty for no analytics. The beacon only runs on the COPYPASTEUI_SITE_URL domain.
NEXT_PUBLIC_CF_BEACON_TOKEN=
